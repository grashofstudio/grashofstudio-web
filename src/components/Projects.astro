---
import Media from './Media.astro';
import Starfield from './Starfield.astro';
import { projects } from '@data/site';
---
<section class="projects section-block" id="work">
  <Starfield />
  <header class="section-heading reveal">
    <p class="section-label">Selected Projects</p>
    <div class="red-rule"></div>
    <h2>Selected Work.</h2>
    <p>目前完成的原型與工程分析</p>
  </header>

  <div class="project-grid">
    {projects.map((project) => (
      <a class="project-card reveal" href={`/projects/${project.slug}/`}>
        <figure><Media media={project.media} /></figure>
        <div class="project-card__body">
          <span class="project-card__index">{project.index}</span>
          <span class="status-label">{project.status}</span>
          <p class="project-card__category">{project.category}</p>
          <h3>{project.title}</h3>
          <p>{project.summary}</p>
          <small>{project.summaryZh}</small>
          <span class="project-card__arrow">→</span>
        </div>
      </a>
    ))}
  </div>
  <span class="section-number">03 / 06</span>
</section>
