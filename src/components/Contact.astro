---
import Starfield from './Starfield.astro';
---
<section class="contact section-block" id="contact">
  <Starfield />
  <div class="contact__content reveal">
    <img src="/logo/grashof-logo-horizontal-dark.png" width="1107" height="219" alt="Grashof" loading="lazy" />
    <p class="section-label">Projects · Technical Collaboration</p>
    <div class="red-rule"></div>
    <h2>Discuss a<br />Technical Project.</h2>
    <a class="contact__mail" href="mailto:hello@grashofstudio.com" aria-label="Email Grashof at hello@grashofstudio.com">
      <span aria-hidden="true">✉</span> hello@grashofstudio.com
    </a>
  </div>
  <div class="contact__planet" aria-hidden="true"><img src="/media/earth-horizon.png" alt="" loading="lazy" /></div>
  <span class="section-number">06 / 06</span>
</section>
