---
import Starfield from './Starfield.astro';
---
<section class="hero" id="home">
  <Starfield />
  <div class="hero__content reveal">
    <p class="section-label">Applied AI Engineering</p>
    <div class="red-rule"></div>
    <h1>Thermal Solutions.<br />Applied AI.</h1>
    <p class="hero__lead">Grashof delivers complete thermal-fluid solutions and custom AI and API applications.</p>
    <p class="hero__zh">格拉索提供完整熱流解決方案與客製 AI、API 落地應用</p>
    <p class="hero__bridge">Design · Integration · Deployment</p>
    <div class="hero__actions">
      <a class="button button--primary" href="#solutions">View Current Work <span>→</span></a>
      <a class="button button--line" href="#contact">Contact Grashof</a>
    </div>
  </div>

  <div class="hero__visual" aria-hidden="true">
    <img src="/media/hero-lunar-horizon.png" alt="" fetchpriority="high" />
    <div class="hero__signals">
      <span>Thermal Digital Twin</span><span>Thermal Solutions</span><span>AI / API Applications</span>
    </div>
  </div>
  <span class="section-number">01 / 06</span>
</section>
