---
import type { Media } from '@data/site';
interface Props {
  media: Media;
  class?: string;
  loading?: 'eager' | 'lazy';
  autoplay?: boolean;
  controls?: boolean;
}
const {
  media,
  class: className = '',
  loading = 'lazy',
  autoplay = true,
  controls = false,
} = Astro.props;
---
{media.type === 'video' ? (
  <video
    class={className}
    src={media.src}
    poster={media.poster}
    aria-label={media.alt}
    muted
    autoplay={autoplay}
    controls={controls}
    loop={autoplay}
    playsinline
    preload="metadata"
  >
    Your browser does not support HTML video.
  </video>
) : (
  <img class={className} src={media.src} alt={media.alt} loading={loading} decoding="async" />
)}
