<canvas class="starfield" id="starfield" aria-hidden="true"></canvas>

<script>
  const canvas = document.querySelector<HTMLCanvasElement>('#starfield');
  const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

  if (canvas && !reduceMotion) {
    const ctx = canvas.getContext('2d', { alpha: true });
    if (ctx) {
      let width = 0;
      let height = 0;
      let ratio = 1;
      let pointerX = 0;
      let pointerY = 0;
      type Star = { x: number; y: number; depth: number; size: number; vx: number; vy: number; phase: number; red: boolean };
      let stars: Star[] = [];

      const resize = () => {
        width = window.innerWidth;
        height = window.innerHeight;
        ratio = Math.min(window.devicePixelRatio || 1, 2);
        canvas.width = Math.floor(width * ratio);
        canvas.height = Math.floor(height * ratio);
        canvas.style.width = `${width}px`;
        canvas.style.height = `${height}px`;
        ctx.setTransform(ratio, 0, 0, ratio, 0, 0);
        stars = Array.from({ length: 165 }, (_, index) => ({
          x: Math.random() * width,
          y: Math.random() * height,
          depth: .2 + Math.random() * .95,
          size: .3 + Math.random() * 1.05,
          vx: -.012 - Math.random() * .032,
          vy: .008 + Math.random() * .026,
          phase: Math.random() * Math.PI * 2,
          red: index < 7,
        }));
      };

      const draw = (time: number) => {
        ctx.clearRect(0, 0, width, height);
        const scrollShift = window.scrollY * .012;
        for (const star of stars) {
          star.x += star.vx * (.5 + star.depth);
          star.y += star.vy * (.5 + star.depth);
          if (star.x < -8) star.x = width + 8;
          if (star.y > height + 8) star.y = -8;
          const x = star.x + pointerX * star.depth * 6;
          const y = (star.y + pointerY * star.depth * 4 + scrollShift * star.depth) % (height + 10);
          const flicker = .54 + Math.sin(time * .0012 + star.phase) * .2;
          const alpha = Math.max(.08, flicker * star.depth * .74);
          ctx.beginPath();
          ctx.arc(x, y, star.size * star.depth, 0, Math.PI * 2);
          ctx.fillStyle = star.red ? `rgba(201,22,37,${alpha * .8})` : `rgba(234,237,241,${alpha})`;
          ctx.fill();
        }
        requestAnimationFrame(draw);
      };

      window.addEventListener('resize', resize);
      window.addEventListener('pointermove', (event) => {
        pointerX = event.clientX / Math.max(width, 1) - .5;
        pointerY = event.clientY / Math.max(height, 1) - .5;
      }, { passive: true });
      resize();
      requestAnimationFrame(draw);
    }
  }
</script>
