<canvas class="starfield" data-starfield aria-hidden="true"></canvas>

<script>
  const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

  if (!reduceMotion) {
    type Star = { x: number; y: number; depth: number; size: number; vx: number; vy: number; phase: number };
    type Field = {
      canvas: HTMLCanvasElement;
      ctx: CanvasRenderingContext2D;
      width: number;
      height: number;
      stars: Star[];
      active: boolean;
    };

    const fields: Field[] = [];
    let pointerX = 0;
    let pointerY = 0;

    document.querySelectorAll<HTMLCanvasElement>('[data-starfield]').forEach((canvas) => {
      if (canvas.dataset.ready === 'true') return;
      const ctx = canvas.getContext('2d', { alpha: true });
      if (!ctx) return;
      canvas.dataset.ready = 'true';
      fields.push({ canvas, ctx, width: 1, height: 1, stars: [], active: true });
    });

    const resizeField = (field: Field) => {
      const bounds = field.canvas.parentElement?.getBoundingClientRect();
      field.width = Math.max(bounds?.width ?? window.innerWidth, 1);
      field.height = Math.max(bounds?.height ?? window.innerHeight, 1);
      const ratio = Math.min(window.devicePixelRatio || 1, 2);
      field.canvas.width = Math.floor(field.width * ratio);
      field.canvas.height = Math.floor(field.height * ratio);
      field.canvas.style.width = `${field.width}px`;
      field.canvas.style.height = `${field.height}px`;
      field.ctx.setTransform(ratio, 0, 0, ratio, 0, 0);
      const starCount = Math.min(240, Math.max(80, Math.round((field.width * field.height) / 15000)));
      field.stars = Array.from({ length: starCount }, () => ({
        x: Math.random() * field.width,
        y: Math.random() * field.height,
        depth: .24 + Math.random() * .76,
        size: .38 + Math.random() * 1.02,
        vx: -.024 - Math.random() * .038,
        vy: .01 + Math.random() * .024,
        phase: Math.random() * Math.PI * 2,
      }));
    };

    const visibilityObserver = new IntersectionObserver((entries) => {
      entries.forEach((entry) => {
        const field = fields.find((item) => item.canvas === entry.target);
        if (field) field.active = entry.isIntersecting;
      });
    }, { rootMargin: '120px' });

    fields.forEach((field) => {
      resizeField(field);
      visibilityObserver.observe(field.canvas);
      const parent = field.canvas.parentElement;
      if (parent) new ResizeObserver(() => resizeField(field)).observe(parent);
    });

    window.addEventListener('pointermove', (event) => {
      pointerX = event.clientX / Math.max(window.innerWidth, 1) - .5;
      pointerY = event.clientY / Math.max(window.innerHeight, 1) - .5;
    }, { passive: true });

    const draw = (time: number) => {
      const scrollShift = window.scrollY * .008;
      for (const field of fields) {
        if (!field.active) continue;
        field.ctx.clearRect(0, 0, field.width, field.height);
        for (const star of field.stars) {
          star.x += star.vx * (.55 + star.depth);
          star.y += star.vy * (.55 + star.depth);
          if (star.x < -8) star.x = field.width + 8;
          if (star.y > field.height + 8) star.y = -8;
          const x = star.x + pointerX * star.depth * 7;
          const y = (star.y + pointerY * star.depth * 5 + scrollShift * star.depth) % (field.height + 10);
          const flicker = .58 + Math.sin(time * .0012 + star.phase) * .2;
          const alpha = Math.max(.08, flicker * star.depth * .82);
          field.ctx.beginPath();
          field.ctx.arc(x, y, star.size * star.depth, 0, Math.PI * 2);
          field.ctx.fillStyle = `rgba(238,241,246,${alpha})`;
          field.ctx.fill();
        }
      }
      requestAnimationFrame(draw);
    };

    requestAnimationFrame(draw);
  }
</script>
