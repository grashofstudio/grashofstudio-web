---
import BaseLayout from './BaseLayout.astro';
import Media from '@components/Media.astro';
import type { ProjectRecord } from '@data/projects';
import { contactEmail } from '@data/site';
import '@styles/project.css';

interface Props { project: ProjectRecord; }
const { project } = Astro.props;
const canonicalPath = `/projects/${project.slug}/`;
---
<BaseLayout title={project.seoTitle ?? `${project.title} | Grashof`} description={project.seoDescription ?? project.description} canonicalPath={canonicalPath}>
  <section class="project-hero">
    <div class="project-hero__copy reveal">
      <a class="back-link" href="/#work">← Back to Selected Projects</a>
      <p class="section-label">{project.category}</p>
      <div class="red-rule"></div>
      <div class="project-status">{project.status}</div>
      <h1>{project.title}</h1>
      <p class="project-hero__lead">{project.description}</p>
      <p class="project-hero__zh">{project.descriptionZh}</p>
      <a class="project-link" href="/#contact">Discuss This Type of Work <span>→</span></a>
    </div>
    <div class:list={["project-hero__media", { "project-hero__media--pair": project.heroMedia.length > 1 }]}>
      {project.heroMedia.map((media) => <Media media={media} loading="eager" autoplay={false} controls={media.type === 'video'} />)}
    </div>
  </section>

  <section class="project-meta reveal" aria-label="Project information">
    <div><span>Role</span><strong>{project.role}</strong></div>
    <div><span>Stage</span><strong>{project.stage}</strong></div>
    <div><span>Category</span><strong>{project.category}</strong></div>
  </section>

  <section class="project-context project-section">
    <header class="project-section__heading reveal"><p class="section-label">Background</p><h2>Project Background.</h2></header>
    <p class="project-context__copy reveal">{project.context}</p>
  </section>

  <section class="project-two-column">
    <article class="project-text reveal"><p class="section-label">Problem</p><h2>Engineering<br />Problem.</h2><p>{project.problem}</p></article>
    <article class="project-text reveal"><p class="section-label">Work Performed</p><h2>What We<br />Did.</h2><p>{project.solution}</p></article>
  </section>

  <section class="project-section deliverables-section">
    <header class="project-section__heading reveal"><p class="section-label">Deliverables</p><h2>Project Outputs.</h2></header>
    <ul class="deliverables reveal">{project.delivered.map((item) => <li>{item}</li>)}</ul>
  </section>

  <section class="project-section approach-section">
    <header class="project-section__heading reveal"><p class="section-label">Process</p><h2>Work Sequence.</h2></header>
    <div class="approach-grid reveal">{project.approach.map((step, index) => <article><span>{String(index + 1).padStart(2,'0')}</span><h3>{step.name}</h3><p>{step.description}</p></article>)}</div>
  </section>

  <section class="project-section evidence-section">
    <header class="project-section__heading reveal"><p class="section-label">Project Material</p><h2>Images and Outputs.</h2></header>
    <div class="evidence-grid reveal">{project.evidence.map((media, index) => <figure class:list={[{ "evidence-grid__wide": index === 0 || media.type === 'video' }]}><Media media={media} autoplay={false} controls={media.type === 'video'} />{media.caption && <figcaption>{media.caption}</figcaption>}</figure>)}</div>
  </section>

  <section class="project-cta">
    {project.relatedLinks && <nav class="project-related" aria-label="Related engineering topics">{project.relatedLinks.map((item) => <a href={item.href}>{item.label}</a>)}</nav>}
    <p class="section-label">Contact</p><div class="red-rule"></div>
    <h2>Discuss a<br />Related Project.</h2>
    <a href={`mailto:${contactEmail}`}><span aria-hidden="true">✉</span>{contactEmail}</a>
  </section>
</BaseLayout>
