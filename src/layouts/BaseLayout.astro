---
import Header from '@components/Header.astro';
import Footer from '@components/Footer.astro';
import '@styles/global.css';
import { siteDescription } from '../data/site';

interface Props {
  title: string;
  description: string;
  canonicalPath?: string;
  ogImage?: string;
  noindex?: boolean;
}

const {
  title,
  description,
  canonicalPath = Astro.url.pathname,
  ogImage = '/og/grashof-og.png',
  noindex = false,
} = Astro.props;
const canonical = new URL(canonicalPath, Astro.site ?? Astro.url.origin);
const socialImage = new URL(ogImage, Astro.site ?? Astro.url.origin);
const organizationSchema = {
  '@context': 'https://schema.org',
  '@type': 'Organization',
  '@id': 'https://grashofstudio.com/#organization',
  name: 'Grashof',
  alternateName: '格拉索工業',
  legalName: '格拉索工業有限公司',
  url: 'https://grashofstudio.com',
  logo: 'https://grashofstudio.com/icons/icon-512.png',
  email: 'hello@grashofstudio.com',
  description: siteDescription,
  address: { '@type': 'PostalAddress', addressCountry: 'TW' },
};
const websiteSchema = {
  '@context': 'https://schema.org',
  '@type': 'WebSite',
  '@id': 'https://grashofstudio.com/#website',
  name: 'Grashof 格拉索工業',
  alternateName: 'Grashof',
  url: 'https://grashofstudio.com/',
  description: siteDescription,
  inLanguage: 'zh-Hant',
  publisher: { '@id': 'https://grashofstudio.com/#organization' },
};
---
<!doctype html>
<html lang="zh-Hant">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <meta name="theme-color" content="#000000" />
    {noindex && <meta name="robots" content="noindex,nofollow" />}
    <link rel="canonical" href={canonical} />
    <link rel="icon" href="/favicon.ico" type="image/x-icon" sizes="16x16 32x32 48x48 64x64" />
    <link rel="icon" href="/icons/favicon-96.png" type="image/png" sizes="96x96" />
    <link rel="apple-touch-icon" href="/icons/apple-touch-icon.png" sizes="180x180" />
    <link rel="manifest" href="/site.webmanifest" />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="Grashof" />
    <meta property="og:locale" content="zh_TW" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={socialImage} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={socialImage} />
    <title>{title}</title>
    <script type="application/ld+json" set:html={JSON.stringify(organizationSchema)}></script>
    {canonical.pathname === '/' && <script type="application/ld+json" set:html={JSON.stringify(websiteSchema)}></script>}
    <script is:inline>document.documentElement.classList.add('js');</script>
    <slot name="head" />
  </head>
  <body>
    <a class="skip-link" href="#main-content">Skip to content</a>
    <div class="site-shell">
      <Header />
      <main id="main-content"><slot /></main>
      <Footer />
    </div>
    <script is:inline>
      const revealObserver = new IntersectionObserver((entries) => {
        entries.forEach((entry) => {
          if (entry.isIntersecting) {
            entry.target.classList.add('is-visible');
            revealObserver.unobserve(entry.target);
          }
        });
      }, { threshold: 0.1 });
      document.querySelectorAll('.reveal').forEach((el) => revealObserver.observe(el));
      const reducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
      document.querySelectorAll('video[autoplay]').forEach((video) => {
        video.muted = true;
        if (reducedMotion) {
          video.pause();
          video.removeAttribute('autoplay');
          return;
        }
        video.play().catch(() => {});
      });
    </script>
  </body>
</html>
