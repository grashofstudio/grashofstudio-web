---
import BaseLayout from '@layouts/BaseLayout.astro';
---
<BaseLayout title="Page Not Found | Grashof" description="The requested page could not be found." noindex>
  <section class="not-found"><p class="section-label">404</p><div class="red-rule"></div><h1>Page Not Found.</h1><p>The requested page does not exist or has moved.</p><a href="/">Return Home →</a></section>
</BaseLayout>
<style>
  .not-found{min-height:80vh;display:grid;align-content:center;padding:8rem var(--page-padding)}.not-found h1{font-size:clamp(3.5rem,7vw,7rem)}.not-found p{color:var(--color-muted)}.not-found a{width:max-content;padding-bottom:.5rem;border-bottom:1px solid var(--color-line-strong);text-decoration:none;font-size:.7rem;letter-spacing:.14em;text-transform:uppercase}.not-found a:hover{color:var(--color-red-bright);border-color:var(--color-red)}
</style>
